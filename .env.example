# Admin account created on first boot; the password applies only then. Change it later with the server console (README).
ADMIN_USERNAME=admin
# Required. Not empty, not "compsci". Wrap in single quotes if it contains $.
ADMIN_PASSWORD=
# Required. Your LAN or VPN IP, the one friends connect to.
GAME_SERVER_IP=
# Where the game files come from: client-folder serves CLIENT_DIR, mirror runs Aurorium (about 19 GB from KingsIsle).
COMPOSE_PROFILES=client-folder
# An installed client at GAME_REVISION, for the client-folder profile. Forward slashes, also on Windows.
CLIENT_DIR=./client
# Address the game-file port 12369 is published on. 0.0.0.0 = all interfaces.
AURORIUM_BIND=0.0.0.0
# The client's revision. With the mirror profile it must match what Aurorium mirrored, without the V_ prefix: curl -s http://127.0.0.1:12369/latest | sed 's/^V_//'
GAME_REVISION=r806919.Wizard_1_610
# true runs the in-game admin panel for staff accounts. Each staff PC also needs the client files: see README, Admin panel.
ADMIN_PANEL_ENABLED=false
# true gives players below HallMonitor filtered chat: they can type only words in the game's chat dictionary. false gives open chat.
CHAT_FILTER_ENABLED=false
# Git URL of your data pack (spiraldb fork); Imlight fetches it on boot.
SPIRALDB_URL=https://github.com/han-xyz/spiraldb.git
