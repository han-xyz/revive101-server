# Admin account created on first boot; the password applies only then.
ADMIN_USERNAME=admin
# Required. Not empty, not "compsci".
ADMIN_PASSWORD=
# Required. Your LAN or VPN IP, the one friends connect to.
GAME_SERVER_IP=
# Address Aurorium's port 12369 is published on. 0.0.0.0 = all interfaces.
AURORIUM_BIND=0.0.0.0
# Must match the revision Aurorium mirrored: curl http://127.0.0.1:12369/latest
GAME_REVISION=r806919.Wizard_1_610
# Git URL of your data pack (spiraldb fork); Imlight fetches it on boot.
SPIRALDB_URL=https://github.com/han-xyz/spiraldb.git
